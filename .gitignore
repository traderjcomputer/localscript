# =============================
# Python 缓存和编译文件
# =============================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# =============================
# 虚拟环境
# =============================
venv/
ENV/
env/
.venv/
venv.bak/
env.bak/

# =============================
# 脚本执行时生成的文件（不提交）
# =============================
# 日志文件
*/logs/
logs/

# 输出数据
*/output/
output/

# 临时文件和缓存
*/temp/
temp/
*.cache
.cache/

# 配置文件（可能包含敏感信息）
*/config/
config/
*.json
!*/data/*.json
!requirements.txt
!pyproject.toml

# =============================
# IDE 和编辑器配置
# =============================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# =============================
# 测试和调试
# =============================
.pytest_cache/
.coverage
htmlcov/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# =============================
# OS 特定文件
# =============================
.DS_Store
.AppleDouble
.LSOverride
*.swp
*.swo
*~

# =============================
# 说明
# =============================
# 保留的目录：
# - */data/ 保留（源输入数据，需要提交）
# - src/lib/ 保留（共享代码库，需要提交）
